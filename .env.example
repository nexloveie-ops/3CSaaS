# Copy to .env.local (never commit secrets)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.hgfe01j.mongodb.net/lz3c?appName=Cluster0
MONGODB_DB_NAME=lz3c
PORT=3000
HOST=0.0.0.0
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
WEB_APP_URL=http://localhost:5173

# Stripe subscription (optional — dev mode activates plans without Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated emails granted Super Admin on register
SUPER_ADMIN_EMAILS=admin@lz3c.local

# Invoice PDF storage (local folder when GCS_BUCKET unset)
LOCAL_STORAGE_PATH=./data
GCS_BUCKET=
GCS_PROJECT_ID=

# PDF: Cloud Run / Docker Alpine installs system chromium and sets:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Local Windows: install Chrome, or set path e.g.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# USE_CHROMIUM=1 is only for @sparticuz/chromium (glibc/Lambda), not Alpine.

# Email (Gmail SMTP recommended — use a Google App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@lztechserve.com
SMTP_PASS=
# Sender address (either key works)
EMAIL_FROM=info@lztechserve.com
SMTP_FROM=info@lztechserve.com
# Optional alternative: SendGrid (used only if SMTP_USER/SMTP_PASS are unset)
SENDGRID_API_KEY=

# Company webhook URL (optional) — set per company via PATCH /companies/:id/settings
# AUDIT_AUTO_PURGE=1
# AUDIT_AUTO_PURGE_HOURS=24
# AUDIT_PURGE_NOTIFY=1

# Twilio (repairs SMS — optional; logs mock message if unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+353...
